# Firefox container identity.
# CyberController uploads/temp is owned by 1003:1003 in the tested lab.
PUID=1003
PGID=1003
TZ=America/Toronto

# Web authentication. Change PASSWORD before deployment.
CUSTOM_USER=admin
PASSWORD=CHANGE_ME

# Host-side HTTPS port.
HOST_PORT=3010

# Persistent Firefox profile and download destinations.
CONFIG_DIR=/opt/firefox-browser/config
UPLOAD_TEMP_DIR=/opt/radware/storage/uploads/temp
MAINTENANCE_DOWNLOAD_DIR=/opt/radware/storage/maintenance/browser-downloads
